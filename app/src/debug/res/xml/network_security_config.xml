<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug only. Allows cleartext HTTP exclusively to the emulator's host machine (10.0.2.2),
    for when local.properties sets sems.api.baseUrl.debug to a local backend.
    Every other host, and every release build, stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
