<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 10–11 (API 29–30).
   Android 12+ uses data_extraction_rules.xml instead.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Session tokens must never leave the device (see SessionModule.SESSION_DATASTORE_NAME). -->
    <exclude domain="file" path="datastore/sems_session.preferences_pb" />
</full-backup-content>
