<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Session tokens must never leave the device (see SessionModule.SESSION_DATASTORE_NAME). -->
    <cloud-backup>
        <exclude domain="file" path="datastore/sems_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sems_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
